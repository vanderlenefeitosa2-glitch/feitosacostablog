# ===== CRM / Painel — variáveis de ambiente =====
# Copie para .env.local (desenvolvimento) e configure também na Vercel (produção).

# ID da planilha (o trecho da URL entre /d/ e /edit)
CRM_SHEET_ID=1IkkZDfr2VPGAK5g3ZySwvXWjpdbuAaQFb0ekuaMBImQ
# Nome da aba (padrão Página1)
CRM_SHEET_NAME=Página1
# (opcional) link direto pro botão "Abrir planilha" do painel
CRM_SHEET_URL=https://docs.google.com/spreadsheets/d/1IkkZDfr2VPGAK5g3ZySwvXWjpdbuAaQFb0ekuaMBImQ/edit

# Conta de serviço do Google (ver SETUP-CRM.md)
GOOGLE_SERVICE_ACCOUNT_EMAIL=nome-da-conta@seu-projeto.iam.gserviceaccount.com
# A chave privada inteira numa linha, com \n no lugar das quebras
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# Segredo do webhook (invente uma senha longa; o GPT Maker manda no header x-webhook-secret)
WEBHOOK_SECRET=troque-por-um-segredo-bem-longo

# Senha do painel
PAINEL_USER=feitosa
PAINEL_SENHA=troque-esta-senha
